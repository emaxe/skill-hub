{
  "name": "@emaxe/skill-hub",
  "version": "0.1.15",
  "description": "Extension manager for AI coding agents (Claude Code, Cursor, Copilot)",
  "bin": {
    "skill-hub": "dist/index.js",
    "skillhub": "dist/index.js",
    "skill-hub-mcp": "dist/mcp-entry.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "base-skills/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaxe/skill-hub.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/emaxe/skill-hub#readme",
  "bugs": {
    "url": "https://github.com/emaxe/skill-hub/issues"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "copilot",
    "ai-agent",
    "skills",
    "extensions",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "ink": "^3.2.0",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "simple-git": "^3.22.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^17.0.80",
    "ink-testing-library": "^2.1.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}
